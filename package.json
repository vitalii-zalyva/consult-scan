{
  "name": "consult-scan",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Nissan Consult-I diagnostics in the browser (Web Serial / WebUSB), built for a 1998 Maxima A32 VQ30DE.",
  "license": "MIT",
  "author": "Vitalii Zalyva",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vitalii-zalyva/consult-scan.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/w3c-web-serial": "^1.0.7",
    "@types/w3c-web-usb": "^1.0.10",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.10",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
